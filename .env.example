# URL pública de la app (se usa para los redirect URIs de OAuth)
APP_URL=http://localhost:3000

# Carpeta para la base de datos SQLite y los archivos temporales de video
DATA_DIR=./data

# Secretos: genera cada uno con `openssl rand -base64 48`
ENCRYPTION_KEY=
SESSION_SECRET=

# Hash de la contraseña de administrador: `pnpm hash-password`
ADMIN_PASSWORD_HASH=

# Microsoft Entra (OneDrive) — https://entra.microsoft.com → App registrations
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Google Cloud (YouTube Data API v3) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IA para títulos y descripciones (las dos son opcionales). Con ANTHROPIC_API_KEY
# se usa Claude; si no, Gemini. La transcripción del audio siempre usa Gemini.
# Claude: https://platform.claude.com/
ANTHROPIC_API_KEY=
# Gemini (tiene capa gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: ruta a un ffmpeg propio en lugar del incluido (ffmpeg-static)
FFMPEG_PATH=

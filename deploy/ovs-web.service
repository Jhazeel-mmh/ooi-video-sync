# Copia a /etc/systemd/system/ y ajusta User y WorkingDirectory.
[Unit]
Description=OOI Video Sync - dashboard web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ovs
WorkingDirectory=/opt/ooi-video-sync
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/env pnpm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
